# Solicita a execução padrão de um job no HTCondor.
Universe = vanilla
# O executável é transferido automaticamente.
Executable = run_make.sh

# Arquivos necessários ao fluxo da matriz sistólica.
transfer_input_files = Makefile, src

# Configurações de transferência
should_transfer_files   = YES
when_to_transfer_output = ON_EXIT

# Retorna os projetos Vivado, VCDs e relatórios gerados pelo fluxo atual.
transfer_output_files = src/hardware/build

# Os TCLs solicitam até quatro processos durante síntese e implementação.
request_cpus = 4
request_memory = 8GB
request_disk = 10GB

# Arquivos de log do Condor (com ID do processo para evitar sobreposição)
output = condor_$(Cluster)_$(Process).out
error  = condor_$(Cluster)_$(Process).err
log    = condor_$(Cluster)_$(Process).log

# O script carrega explicitamente o ambiente do Vivado quando necessário.
GetEnv = False

Queue
